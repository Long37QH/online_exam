{
    "kind": "collectionType",
    "collectionName": "user_quizzes",
    "info": {
        "singularName": "user-quizz",
        "pluralName": "user-quizzes",
        "displayName": "UserQuizz",
        "description": ""
    },
    "options": {
        "draftAndPublish": true
    },
    "attributes": {
        "score": {
            "type": "decimal",
            "required": true,
            "default": 0
        },
        "start_at": {
            "type": "datetime",
            "required": true
        },
        "completed_at": {
            "type": "datetime",
            "required": false
        },
        "user": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "plugin::users-permissions.user",
            "inversedBy": "user_quizzes"
        },
        "status_user_quiz": {
            "type": "string",
            "default": "Not done"
        },
        "result": {
            "type": "json"
        },
        "quiz": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::quizz.quizz",
            "inversedBy": "user_quizzes"
        }
    }
}
